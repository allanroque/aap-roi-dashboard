# ---- Grafana ----
GRAFANA_PORT=3030
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=troque-esta-senha
GRAFANA_ROOT_URL=http://grafana.exemplo.local:3030/

# ---- Banco do Automation Controller (AAP) ----
# Containerizado no mesmo host do Grafana: AAP_PG_HOST=host.containers.internal
# RPM / banco externo / OpenShift exposto: FQDN ou IP do PostgreSQL
AAP_PG_HOST=host.containers.internal
AAP_PG_PORT=5432
AAP_PG_DATABASE=awx
AAP_PG_USER=grafana_ro
AAP_PG_PASSWORD=senha-do-grafana_ro
# disable (sem TLS) | require (TLS sem validar CA) | verify-full (TLS validando CA)
AAP_PG_SSLMODE=require
